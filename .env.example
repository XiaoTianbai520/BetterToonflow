# 开发环境：三端在开发机运行，Java 直连服务器现有 PostgreSQL。
# 复制为仓库根目录 .env，填写数据库密码和内部 Token；禁止提交实际密钥。
# Token 可用 openssl rand -hex 32 生成，两后端必须使用相同值。
TOONFLOW_DB_URL=jdbc:postgresql://192.168.1.102:5432/toonflow
TOONFLOW_DB_USERNAME=root
TOONFLOW_DB_PASSWORD=
TOONFLOW_INTERNAL_TOKEN=

# 在仓库根目录分别打开三个终端启动（Bun 将 .env 注入子进程，Java 不会自动读取 .env）：
# bun --env-file=.env exec "cd apps/server && mvn spring-boot:run"
# bun --env-file=.env run dev:agentRuntime
# bun run dev:web
# 前端通过 Vite /api 代理访问本机 Java 3000，Java 访问本机 Runtime 3001。
# data 使用两后端现有默认路径，均指向仓库根目录 data；不使用容器的 /app/data。
# 当前仅 PostgreSQL 是外部中间件，前端和 Runtime 不直接连接数据库。

# 部署环境：使用 compose.yaml 编排完整容器栈，与以上开发连接参数独立。
# Compose 显式覆盖应用数据库地址和数据目录，不使用以上 TOONFLOW_DB_* 值。
# 填写独立的部署数据库密码后执行 docker compose up --build -d --wait。
POSTGRES_DB=toonflow
POSTGRES_USER=toonflow
POSTGRES_PASSWORD=

# 默认仅允许本机访问网关；需向局域网提供服务时可改为 0.0.0.0。
# agentRuntime 和 PostgreSQL 均不发布宿主机端口。
TOONFLOW_BIND_ADDRESS=127.0.0.1
